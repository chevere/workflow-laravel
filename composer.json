{
    "name": "chevere/workflow-laravel",
    "description": "Chevere Workflow integration for Laravel.",
    "homepage": "https://chevere.org",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rodolfo Berrios",
            "email": "rodolfo@chevere.org",
            "homepage": "https://chevere.org"
        }
    ],
    "require": {
        "php": "^8.2",
        "chevere/workflow": "^3.0.7",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5|^11.5.3|^12.0",
        "symplify/easy-coding-standard": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Chevere\\Workflow\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chevere\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chevere\\Workflow\\Laravel\\WorkflowServiceProvider"
            ],
            "aliases": {
                "Workflow": "Chevere\\Workflow\\Laravel\\Facades\\Workflow"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "all": [
            "composer phpstan",
            "composer test",
            "composer test-coverage",
            "composer infection -- --skip-initial-tests --coverage=build/logs"
        ],
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "infection -j10"
        ],
        "infection-filter": "sh -c 'sh -c \"composer infection -- --filter=$0 --test-framework-options=--filter=$1\"' $1 $2",
        "phpstan": "vendor/bin/phpstan analyze ./src --memory-limit 512M --level 9",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.xml --no-coverage"
        ],
        "test-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.xml"
        ],
        "coverage:open": "open build/logs/html/index.html",
        "infection:open": "open build/logs/html/infection.html",
        "cs:fix": "vendor/bin/ecs --config='.ecs/ecs.php' src --fix",
        "cs:update": "mkdir -p .ecs && cd .ecs && curl -O https://raw.githubusercontent.com/chevere/code-style/main/.ecs/ecs-chevere.php",
        "ci:update": "cd .github/workflows && curl -O https://raw.githubusercontent.com/chevere/package-template/main/.github/workflows/test.yml -O https://raw.githubusercontent.com/chevere/package-template/main/.github/workflows/sonarqube.yml",
        "infection:dist:update": "curl -O https://raw.githubusercontent.com/chevere/package-template/main/infection.json.dist",
        "package-template:update": "composer cs:update && composer ci:update && composer infection:dist:update"
    },
    "scripts-descriptions": {
        "all": "Runs all checks",
        "infection": "Runs infection",
        "infection-filter": "Runs infection filtered (args infection-filter phpunit-filter)",
        "phpstan": "Runs phpstan",
        "test": "Run test suite",
        "test-coverage": "Run test suite (coverage)",
        "coverage:open": "Open code coverage report",
        "infection:open": "Open infection report",
        "cs:fix": "Update Chevere code style definition",
        "cs:update": "Update Chevere code style definition",
        "ci:update": "Update CI workflow files",
        "infection:dist:update": "Update infection dist file",
        "package-template:update": "Update template files"
    }
}
